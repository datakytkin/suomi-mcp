# Datasilta Gateway -ympäristömuuttujat. Kopioi: cp .env.example .env
# (gateway.ts lukee process.env:stä; lataa .env haluamallasi tavalla,
#  esim. `node --env-file=.env dist/gateway.js` Node 20.6+ )

# Portti jota Gateway kuuntelee.
PORT=3000

# KEHITYS VAIN: hyväksy mikä tahansa >=3 merkin token (plan "free").
# Älä aseta tuotannossa – silloin käytössä ovat vain auth.ts:n mock-tokenit
# (demo / 123 / enterprise), jotka korvataan oikealla asiakastietokannalla.
DATASILTA_DEV_ALLOW_ANY=1
