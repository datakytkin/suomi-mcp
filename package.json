{
  "name": "datakytkin-mcp",
  "version": "0.4.0",
  "description": "MCP-työkalut suomalaiseen avoimeen dataan (PRH/YTJ, Hilma). Ajettavissa paikallisena stdio-palvelimena tai keskitettynä Datasilta-Gatewayna (SSE / Streamable HTTP).",
  "type": "module",
  "license": "MIT",
  "author": "Tomi Salmi",
  "homepage": "https://github.com/datakytkin/suomi-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datakytkin/suomi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/datakytkin/suomi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "prh",
    "ytj",
    "hilma",
    "hankintailmoitukset",
    "finland",
    "avoin-data",
    "open-data"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "datakytkin-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:gateway": "tsx watch src/gateway.ts",
    "start": "node dist/index.js",
    "start:gateway": "node dist/gateway.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
